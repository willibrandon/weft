<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <AssemblyName>Weft.Tests</AssemblyName>
    <RootNamespace>Weft.Tests</RootNamespace>
    <Description>Real behavior tests for weft.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hex1b" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Weft.Core/Weft.Core.csproj" />
    <ProjectReference Include="../../src/Weft.Protocol/Weft.Protocol.csproj" />
    <ProjectReference Include="../../src/Weft.Server/Weft.Server.csproj" />
    <ProjectReference Include="../../src/Weft.Client/Weft.Client.csproj" />
    <ProjectReference Include="../../src/Weft.Mcp/Weft.Mcp.csproj" />
    <ProjectReference Include="../../src/Weft.App/Weft.App.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Tests run this file-based helper as the shell in real pseudo-terminals, so every operating system runs the same scripts. -->
  <Target Name="WeftBuildTestPrograms" AfterTargets="Build" Inputs="../programs/TestShell.cs" Outputs="$(OutDir)programs/TestShell.dll">
    <PropertyGroup>
      <WeftDotnetHost>$(DOTNET_HOST_PATH)</WeftDotnetHost>
      <WeftDotnetHost Condition="'$(WeftDotnetHost)' == ''">dotnet</WeftDotnetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(WeftDotnetHost)&quot; build &quot;$(MSBuildThisFileDirectory)../programs/TestShell.cs&quot; -c $(Configuration) -o &quot;$(OutDir)programs&quot;" />
  </Target>
</Project>
